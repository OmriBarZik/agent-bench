{
  "permissions": {
    "deny": ["Bash(cd *)", "Bash(pushd *)", "Bash(popd *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/../agent-bench/hooks/tool-log.ts pre"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/../agent-bench/hooks/baseline-guard.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/../agent-bench/hooks/tool-log.ts post"
          }
        ]
      }
    ]
  }
}
