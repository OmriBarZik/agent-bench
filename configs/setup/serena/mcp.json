{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "../agent-bench/configs/setup/serena/context.yml",
        "--agent-interface",
        "tools",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false"
      ]
    }
  }
}
