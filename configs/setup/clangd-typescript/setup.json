{
  "checks": [
    {
      "label": "Chromium clangd",
      "kind": "file",
      "target": "${CHROMIUM_SRC}/third_party/llvm-build/Release+Asserts/bin/clangd",
      "fix": "set checkout_clangd in .gclient, then gclient sync"
    },
    {
      "label": "out/Default",
      "kind": "file",
      "target": "${CHROMIUM_SRC}/out/Default/build.ninja",
      "fix": "gn gen out/Default"
    },
    {
      "label": "compile_commands.json",
      "kind": "file",
      "target": "${CHROMIUM_SRC}/compile_commands.json",
      "fix": "bun run setup:clangd"
    },
    {
      "label": "typescript-language-server",
      "kind": "command",
      "target": "typescript-language-server",
      "fix": "bun install -g typescript-language-server"
    },
    {
      "label": "node",
      "kind": "command",
      "target": "node",
      "fix": "install Node.js; typescript-language-server runs on it"
    },
    {
      "label": "checkout tsserver",
      "kind": "file",
      "target": "${CHROMIUM_SRC}/third_party/devtools-frontend/src/node_modules/typescript/lib/_tsserver.js",
      "fix": "gclient sync, so third_party/devtools-frontend/src is at its gitlink"
    }
  ]
}
