{
  "name": "typescript-lsp",
  "version": "1.0.0",
  "description": "TypeScript 7 language server. Diagnostics on the JavaScript and TypeScript files the agent edits.",
  "lspServers": {
    "typescript": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "startupTimeout": 120000,
      "requestTimeout": 120000,
      "maxRestarts": 1,
      "diagnostics": true
    }
  }
}
